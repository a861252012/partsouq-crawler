[Unit]
Description=Start NHTSA and PartSouq synchronization on day 1 at 01:00 Asia/Taipei

[Timer]
OnCalendar=*-*-01 01:00:00 Asia/Taipei
# Recover automatically after a host reboot or hard process failure during a long run.
# The monthly DB lease makes these checks a no-op while a run is active or complete.
OnCalendar=*-*-01 02..23:00:00 Asia/Taipei
OnCalendar=*-*-02..03 *:00:00 Asia/Taipei
Persistent=true
AccuracySec=1min
Unit=partsouq-monthly-sync.service

[Install]
WantedBy=timers.target
