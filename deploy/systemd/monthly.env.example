PARTSOUQ_CORE_PYTHON=/opt/partsouq-crawler/current/.venv/bin/python
PARTSOUQ_XVFB_RUN=/usr/bin/xvfb-run

PARTSOUQ_MYSQL_HOST=127.0.0.1
PARTSOUQ_MYSQL_PORT=3306
PARTSOUQ_MYSQL_DATABASE=partsouq
PARTSOUQ_MYSQL_USER=partsouq
PARTSOUQ_MYSQL_PASSWORD=replace-me
PARTSOUQ_MYSQL_POOL_MIN_SIZE=1
PARTSOUQ_MYSQL_POOL_MAX_SIZE=10

PARTSOUQ_USER_AGENT=partsouq-monthly-sync/0.1 (contact: replace@example.com)
PARTSOUQ_DELAY_SECONDS=5
PARTSOUQ_REQUEST_TIMEOUT_SECONDS=60
PARTSOUQ_MAX_RETRIES=3
PARTSOUQ_ROBOTS_POLICY=require
PARTSOUQ_BROWSER_EXECUTABLE=/usr/bin/google-chrome-stable
PARTSOUQ_BROWSER_HEADLESS=0
PARTSOUQ_BROWSER_SANDBOX=1
PARTSOUQ_BROWSER_PROFILE_DIR=/var/lib/partsouq-crawler/browser-profile
PARTSOUQ_BROWSER_WORKER_COMMAND=/opt/partsouq-crawler/current/.venv-browser/bin/python /opt/partsouq-crawler/current/browser_worker/worker.py
PARTSOUQ_BROWSER_CHALLENGE_WAIT_SECONDS=60
PARTSOUQ_BROWSER_RESTART_PAGES=500

NHTSA_MYSQL_HOST=127.0.0.1
NHTSA_MYSQL_PORT=3306
NHTSA_MYSQL_DATABASE=nhtsa
NHTSA_MYSQL_USER=nhtsa
NHTSA_MYSQL_PASSWORD=replace-me
NHTSA_RAW_DIR=/var/lib/partsouq-crawler/nhtsa-raw
NHTSA_USER_AGENT=nhtsa-official-data-sync/0.1
NHTSA_REQUEST_TIMEOUT_SECONDS=120
NHTSA_API_DELAY_SECONDS=0.2

MONTHLY_SYNC_TIMEZONE=Asia/Taipei
MONTHLY_SYNC_LEASE_SECONDS=900
MONTHLY_SYNC_HEARTBEAT_SECONDS=60
MONTHLY_SYNC_MAX_ATTEMPTS=3
